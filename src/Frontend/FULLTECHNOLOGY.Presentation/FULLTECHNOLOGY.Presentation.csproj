<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-292" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Backend\FULLTECHNOLOGY.Application\FULLTECHNOLOGY.Application.csproj" />
    <ProjectReference Include="..\..\Backend\FULLTECHNOLOGY.Domain\FULLTECHNOLOGY.Domain.csproj" />
    <ProjectReference Include="..\..\Backend\FULLTECHNOLOGY.Infrastructure\FULLTECHNOLOGY.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms añade these global usings que chocan con Avalonia (Color, Control, etc.).
         Se quitan del ámbito global; InvoicePrinter las importa explícitamente. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.Drawing2D" />
    <Using Remove="System.Drawing.Printing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
<ItemGroup>
    <InternalsVisibleTo Include="FULLTECHNOLOGY.Presentation.Tests" />
  </ItemGroup>

</Project>
