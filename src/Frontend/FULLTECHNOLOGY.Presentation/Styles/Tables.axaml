<!-- Tables.axaml — Estilos de tablas (los recursos son tokens, NO se traducen). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header de tabla (fila de columnas fijas) spec §3.3.d -->
    <Style Selector="Border.TableHeader">
        <Setter Property="Background" Value="{DynamicResource BgRowAlt}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusTableButton}" />
        <Setter Property="Padding" Value="{DynamicResource PaddingTableHeader}" />
        <Setter Property="Height" Value="{DynamicResource HeightTableHeader}" />
    </Style>
    <!-- Texto del encabezado: 12px semibold en color secundario. -->
    <Style Selector="TextBlock.TableHeader">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTableHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Fila de tabla, separador inferior, hover -->
    <Style Selector="Border.TableRow">
        <Setter Property="Height" Value="{DynamicResource HeightTableRow}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    </Style>
    <!-- Hover de fila: fondo alterno. -->
    <Style Selector="Border.TableRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgRowAlt}" />
    </Style>
    <!-- Celda de tabla: 13px en color principal, centrado vertical. -->
    <Style Selector="TextBlock.TableCell">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTable}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>