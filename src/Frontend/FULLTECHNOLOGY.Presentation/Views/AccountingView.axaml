<!-- AccountingView.axaml — Módulo contable: cierre con filtros y tabla de movimientos, balance con gráfica LiveCharts2 (ColumnSeries<ObservableValue>) y exportación PDF/Excel. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FULLTECHNOLOGY.Presentation.ViewModels"
             xmlns:m="using:FULLTECHNOLOGY.Presentation.ViewModels.Accounting"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:conv="using:FULLTECHNOLOGY.Presentation.Converters"
             x:Class="FULLTECHNOLOGY.Presentation.Views.AccountingView"
             x:DataType="vm:AccountingViewModel">

    <UserControl.Resources>
        <!-- Recurso local: pincel fijo para resaltar la fila de total (excepción puntual; el resto de colores son tokens). -->
        <SolidColorBrush x:Key="TotalRowBrush" Color="#2A2F3A" />
        <!-- Convertidor local: TotalHighlight aplica TotalRowBrush cuando EsTotal=true (fila de total) o Transparent. -->
        <conv:BoolToBrushConverter x:Key="TotalHighlight" TrueBrush="{StaticResource TotalRowBrush}" FalseBrush="Transparent" />
    </UserControl.Resources>

    <!-- Layout vertical: barra de filtros (2 filas) → resumen del periodo (34) → contenido de tabs (*). -->
    <Grid RowDefinitions="Auto,34,*" RowSpacing="10">

        <!-- ========= Barra de filtros ========= -->
        <!-- Fila 1: rango de fechas, vista, medio de pago y buscador con columnas * proporcionales
             (MinWidth en los controles) para que nunca se encimen ni salgan de pantalla. -->
        <Grid RowDefinitions="44,44" RowSpacing="6">
            <Grid ColumnDefinitions="Auto,1.2*,Auto,1.2*,1.5*,Auto,1.1*,2.0*" ColumnSpacing="4">
               
				<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">Desde:</TextBlock>
                <DatePicker Grid.Column="1" Height="{DynamicResource HeightControl}" MinWidth="120" Width="120" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center"
                            SelectedDate="{Binding FechaDesde, Mode=TwoWay}" 
							DayFormat="dd"
						    MonthFormat="MM"
						    YearFormat="yyyy"  />
                
				<TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">Hasta:</TextBlock>
                <DatePicker Grid.Column="3" Height="{DynamicResource HeightControl}" MinWidth="0" Width="120" MaxWidth="150" HorizontalAlignment="Center" VerticalAlignment="Center"
                            SelectedDate="{Binding FechaHasta, Mode=TwoWay}"
							DayFormat="dd"
						    MonthFormat="MM"
						    YearFormat="yyyy" />
                
				<!-- Selector de vista del cierre (p. ej. por día/mes). -->
                <ComboBox Grid.Column="4" Height="{DynamicResource HeightControl}" MinWidth="140" VerticalAlignment="Center"
                          ItemsSource="{Binding VistaOptions}" SelectedIndex="{Binding VistaIndex}" />
                
				<TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">Medio:</TextBlock>
                <ComboBox Grid.Column="6" Height="{DynamicResource HeightControl}" MinWidth="130" VerticalAlignment="Center"
                          ItemsSource="{Binding MetodoOptions}" SelectedIndex="{Binding MetodoIndex}" />
               
				<Grid Grid.Column="7" VerticalAlignment="Center">
                    <!-- Buscador con lupa (búsqueda en vivo); la lupa (⌕) es decorativa. -->
                    <TextBox Classes="Input" Padding="{DynamicResource PaddingInputIconCompact}" Height="{DynamicResource HeightControl}" MinWidth="200"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Buscar cliente o producto..." />
                    <TextBlock Text="&#x2315;" FontSize="{DynamicResource FontSizeTitle}" Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <!-- Fila 2: resumen compacto V/C a la izquierda y exportación PDF/Excel a la derecha. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="V:" Foreground="{DynamicResource AccentPrimaryLight}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding VentasText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="C:" Foreground="{DynamicResource StatusSuccess}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CobrosText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Classes="Secondary" Height="{DynamicResource HeightControl}" Click="OnExportPdf" ToolTip.Tip="Exportar el cierre a PDF">PDF</Button>
                    <Button Classes="Secondary" Height="{DynamicResource HeightControl}" Click="OnExportExcel" ToolTip.Tip="Exportar el cierre a Excel">Excel</Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========= Resumen del periodo ========= -->
        <!-- Banda de resumen: Ventas (acento), Cobros (success) y Total del periodo (bold success). -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="{DynamicResource RadiusCard}" Padding="16,0">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ventas:" Foreground="{DynamicResource AccentPrimaryLight}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VentasText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="Cobros:" Foreground="{DynamicResource StatusSuccess}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CobrosText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="Total del periodo:" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource StatusSuccess}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========= Contenido con tabs Cierre / Balance ========= -->
        <!-- Pestañas: "Cierre" (tabla de movimientos) y "Balance" (gráfica de barras de LiveCharts2). -->
        <TabControl Grid.Row="2">
            <TabItem Header="Cierre">
                <!-- Un solo ScrollViewer horizontal mantiene header + filas alineados (TreeDataGrid #256) -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="720" RowDefinitions="40,*,30" Margin="8">
                    <!-- Encabezado de columnas -->
                    <!-- Columnas dinámicas del cierre, generadas por el VM en "Columns". -->
                    <Border Classes="TableHeader" Padding="{DynamicResource PaddingTableHeader}">
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="TableHeader" Text="{Binding}" MinWidth="96" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Filas del catálogo -->
                    <!-- Filas de movimientos: celdas dinámicas (Cells) y fondo de la fila de total
                         resuelto con el convertidor local TotalHighlight sobre EsTotal. -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:CierreRowViewModel">
                                        <Border Classes="TableRow" Padding="{DynamicResource PaddingTableRow}"
                                                Background="{Binding EsTotal, Converter={StaticResource TotalHighlight}}">
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="m:CierreCellViewModel">
                                                        <TextBlock Classes="TableCell" Text="{Binding Value}" MinWidth="96" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Estado vacío -->
                        <!-- Mensaje central cuando no hay movimientos para el periodo y filtros (IsEmpty). -->
                        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Classes="StateGlyph" Text="&#x25A4;" FontSize="{DynamicResource FontSizeEmpty}" />
                            <TextBlock Classes="StateBody" Text="No hay movimientos para el periodo y filtros seleccionados." />
                        </StackPanel>
                    </Grid>

                    <!-- Pie del cierre -->
                    <!-- Resumen del pie: periodo y cantidad de facturas. -->
                    <Border Grid.Row="2" Background="{DynamicResource BgApp}" CornerRadius="{DynamicResource RadiusCard}">
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                            <TextBlock Text="{Binding PeriodoText}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="1" Text="{Binding FacturasText}" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Balance">
                <!-- Gráfica de balance: lvc:CartesianChart con Series/XAxes/YAxes desde el VM
                     (ColumnSeries<ObservableValue>) y leyenda a la derecha. -->
                <Grid Margin="8">
                    <Border Background="{DynamicResource BgCard}" CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True">
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}"
                                           YAxes="{Binding YAxes}" LegendPosition="Right"
                                           Margin="16,8,16,8" MinHeight="300" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Estado: cargando (F12) — cubre ambos tabs -->
        <!-- Overlay de carga que cubre la zona de los tabs mientras IsLoading. -->
        <Border Grid.Row="2" Classes="LoadingOverlay" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar Width="180" IsIndeterminate="True" />
                <TextBlock Text="Cargando cierre..." Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Estado: error de carga (mensaje amigable + reintento) -->
        <!-- Overlay de error (opacidad alta): glifo ⚠, título, mensaje del VM y Reintentar. -->
        <Border Grid.Row="2" Classes="LoadingOverlay error" IsVisible="{Binding IsError}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="480">
                <TextBlock Classes="StateGlyph StateGlyphError" Text="&#x26A0;" />
                <TextBlock Classes="StateTitle" Text="No se pudo cargar el cierre contable" />
                <TextBlock Classes="StateBody" Text="{Binding ErrorMessage}" />
                <Button Classes="Secondary" Content="Reintentar" Command="{Binding RetryCommand}"
                        HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>