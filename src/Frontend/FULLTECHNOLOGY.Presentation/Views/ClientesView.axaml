<!-- ClientesView.axaml — Módulo de clientes/proveedores: toolbar de filtros, tabla paginada con estados de carga/error/vacío y pie resumen. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FULLTECHNOLOGY.Presentation.ViewModels"
             xmlns:vmm="using:FULLTECHNOLOGY.Presentation.ViewModels.Clientes"
             xmlns:auto="using:Avalonia.Automation"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="FULLTECHNOLOGY.Presentation.Views.ClientesView"
             x:DataType="vm:ClientesViewModel">

    <!-- Layout vertical: fila toolbar → tabla (*) → pie de resumen. -->
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">

        <!-- ===================== TOOLBAR ===================== -->
        <!-- Barra superior: botón "+ Nuevo cliente", combo de tipo, combo de campo de búsqueda y buscador con lupa. -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,*" ColumnSpacing="12" Height="{DynamicResource HeightToolbar}">
            <Button Classes="Primary" Content="+ Nuevo cliente"
                    Command="{Binding NuevoClienteCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" />

            <!-- Combo de tipo de cliente -->
            <!-- Filtro por Tipo (cliente/proveedor); sus opciones y selección vienen del VM. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Tipo:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <ComboBox Classes="Filter" Width="150" Height="{DynamicResource HeightToolbar}"
                          ItemsSource="{Binding TipoOptions}"
                          SelectedItem="{Binding SelectedTipo}" />
            </StackPanel>

            <!-- Campo por el que se busca -->
            <!-- Selecciona sobre qué campo aplicar la búsqueda (nombre, documento, celular...). -->
            <ComboBox Grid.Column="3" Classes="Filter" Width="150" Height="{DynamicResource HeightToolbar}"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding FilterFieldOptions}"
                      SelectedItem="{Binding SelectedFilterField}" />

            <!-- Buscador con lupa (búsqueda en vivo) -->
            <!-- Búsqueda en vivo (PropertyChanged); la lupa (⌕) es decorativa (IsHitTestVisible=False). -->
            <Grid Grid.Column="4" Height="{DynamicResource HeightToolbar}">
                <TextBox Classes="Input" Height="{DynamicResource HeightToolbar}" Padding="{DynamicResource PaddingInputIcon}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Buscar..." />
                <TextBlock Text="&#x2315;" FontSize="{DynamicResource FontSizeIcon}" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,14,0" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- ===================== TABLA ===================== -->
        <!-- Tarjeta de tabla: header de columnas + cuerpo con scroll y overlays de estado. -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}"
                CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True">
            <!-- Un solo ScrollViewer horizontal mantiene header + filas alineados (TreeDataGrid #256) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="900" RowDefinitions="Auto,*">

                    <!-- Header de columnas -->
                    <Border Classes="TableHeader" Padding="{DynamicResource PaddingTableHeader}">
                        <Grid>
<Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" MinWidth="130" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="TableHeader" Text="Tipo" />
                        <TextBlock Grid.Column="1" Classes="TableHeader" Text="Nombre" />
                        <TextBlock Grid.Column="2" Classes="TableHeader" Text="Documento/Nit" />
                        <TextBlock Grid.Column="3" Classes="TableHeader" Text="Celular" />
                        <TextBlock Grid.Column="4" Classes="TableHeader" Text="Dirección" />
                        <TextBlock Grid.Column="5" Classes="TableHeader" Text="Web" />
                        <TextBlock Grid.Column="6" Classes="TableHeader" Text="Red Social" />
                        <TextBlock Grid.Column="7" Classes="TableHeader" Text="Opciones" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Cuerpo: filas + estados vacío/cargando -->
                    <!-- Capa de filas: ItemsControl con scroll vertical. La primera columna incluye un punto de
                         acento junto al tipo; la última un botón de acciones (⋯) resuelto en code-behind. -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmm:ClienteRowViewModel">
                                        <Border Classes="TableRow" Padding="{DynamicResource PaddingTableRow}">
                                            <Grid>
<Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{DynamicResource AccentPrimaryLight}" />
                                                <TextBlock Text="{Binding Tipo}" Classes="TableCell" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Nombre}" Classes="TableCell"
                                                       Foreground="{DynamicResource AccentPrimaryLight}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nombre}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Documento}" Classes="TableCell"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Celular}" Classes="TableCell"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding Direccion}" Classes="TableCell"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Direccion}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Web}" Classes="TableCell"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="6" Text="{Binding RedSocial}" Classes="TableCell"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <!-- Botón de acciones sin texto (⋯): menú vía code-behind, accesible por AutomationProperties. -->
                                                <Button Classes="Table" Width="44" Content="&#x22EF;"
                                                        Click="OnOptionsClick" ToolTip.Tip="Acciones del cliente"
                                                        auto:AutomationProperties.Name="Acciones del cliente" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado: cargando -->
                    <!-- Overlay con ProgressBar mientras IsLoading. -->
                    <Border Classes="LoadingOverlay" IsVisible="{Binding IsLoading}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar Width="180" IsIndeterminate="True" />
                            <TextBlock Text="Cargando clientes..." Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Estado: error de carga (mensaje amigable + reintento) -->
                    <!-- Overlay de error (opacidad alta): glifo ⚠, título, mensaje del VM y Reintentar. -->
                    <Border Classes="LoadingOverlay error" IsVisible="{Binding IsError}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="480">
                            <TextBlock Classes="StateGlyph StateGlyphError" Text="&#x26A0;" />
                            <TextBlock Classes="StateTitle" Text="No se pudieron cargar los clientes" />
                            <TextBlock Classes="StateBody" Text="{Binding ErrorMessage}" />
                            <Button Classes="Secondary" Content="Reintentar" Command="{Binding RetryCommand}"
                                    HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Estado: vacío -->
                    <!-- Mensaje central cuando no hay clientes con los filtros actuales (IsEmpty). -->
                    <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Classes="StateGlyph" Text="&#x25C9;" />
                        <TextBlock Classes="StateBody" Text="No se encontraron clientes con los filtros actuales." />
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===================== PIE ===================== -->
        <!-- Pie: total de clientes y tipo de cliente seleccionado. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TextSecondary}">Clientes:</TextBlock>
                <TextBlock Text="{Binding TotalRows}" VerticalAlignment="Center" />
                <TextBlock Foreground="{DynamicResource TextSecondary}">·</TextBlock>
                <TextBlock Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">Tipo:</TextBlock>
                <TextBlock Text="{Binding SelectedTipo}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>