<!-- EditDiagnosticoView.axaml — Diálogo de edición de diagnóstico/reparación: diagnóstico, trabajo realizado y observaciones. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FULLTECHNOLOGY.Presentation.ViewModels.Dialogs"
        x:Class="FULLTECHNOLOGY.Presentation.Views.Dialogs.EditDiagnosticoView"
        x:DataType="vm:EditDiagnosticoViewModel"
        Title="{Binding Title}"
        Width="760" Height="520" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource BgApp}">

    <DockPanel>
        <!-- Pie de acciones: Cancelar / Guardar cambios con handlers de code-behind. -->
        <Border DockPanel.Dock="Bottom" Padding="{DynamicResource PaddingDialogFooter}" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Classes="Secondary" Content="Cancelar" Click="OnCancel" />
                <Button Classes="Primary" Content="Guardar cambios" Click="OnSave" />
            </StackPanel>
        </Border>

        <!-- Formulario: referencia de la orden y las tres cajas de texto multilínea (Diagnóstico/Trabajo/Observaciones). -->
        <StackPanel Margin="24" Spacing="16">
            <!-- Identificador de la orden que se está editando. -->
            <TextBlock Text="{Binding OrdenLabel}" FontSize="{DynamicResource FontSizeCardTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />

            <!-- Tres áreas de texto multilínea con ajuste de línea, enlazadas en TwoWay. -->
            <Grid ColumnDefinitions="190,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                <TextBlock Text="Diagnóstico" VerticalAlignment="Top" Margin="0,8,0,0" />
                <TextBox Grid.Column="1" Classes="Input" Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Diagnostico, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="Trabajo realizado" VerticalAlignment="Top" Margin="0,8,0,0" />
                <TextBox Grid.Column="1" Grid.Row="1" Classes="Input" Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding TrabajoRealizado, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Text="Observaciones" VerticalAlignment="Top" Margin="0,8,0,0" />
                <TextBox Grid.Column="1" Grid.Row="2" Classes="Input" Height="92" AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Observaciones, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </DockPanel>

</Window>